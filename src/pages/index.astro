---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
---
<BaseLayout>
  <Header />
  <main>
    <HeroCarousel />
    <section class="reality-section">
      <div class="wrap">
        <div class="reality-top"><div><p class="eyebrow"><span class="eyebrow-dot"></span> Technology with purpose</p><h2>Make the complex<br />feel <em>clear.</em></h2><p class="body-large">Good systems give people more room to focus on what they do best.</p></div><div class="reality-copy"><p>We bring practical advice and dependable support to the technology decisions behind your business. Start with one challenge, then build toward a smarter way of working.</p><a class="text-link" href="/about">Get to know Papi's Systems <span aria-hidden="true">→</span></a></div></div>
        <div class="process-track"><div class="process-line"></div><article><span class="process-step">01</span><span class="process-dot"></span><h3>Listen</h3><p>Understand the people and the problem.</p></article><article><span class="process-step">02</span><span class="process-dot"></span><h3>Plan</h3><p>Find a solution that fits your needs.</p></article><article><span class="process-step">03</span><span class="process-dot"></span><h3>Connect</h3><p>Make your systems work together.</p></article><article><span class="process-step">04</span><span class="process-dot"></span><h3>Support</h3><p>Keep improving as your business grows.</p></article></div>
      </div>
    </section>
    <section class="services-band"><div class="wrap"><div class="section-label"><span>02 / What we can help with</span><span class="label-line"></span><a href="/services">All services ↗</a></div>
      <div class="service-grid">
        <a class="service-card" href="/services"><span class="service-number">01</span><span class="service-icon"><ServiceIcon type="systems" /></span><h3>IT &amp; systems<br />that fit</h3><p>Build a reliable technology foundation that works for your people and your plans.</p><span class="service-arrow" aria-hidden="true">↗</span></a>
        <a class="service-card" href="/services"><span class="service-number">02</span><span class="service-icon"><ServiceIcon type="workflow" /></span><h3>Smarter ways<br />of working</h3><p>Connect tools and workflows to cut friction and give good ideas room to grow.</p><span class="service-arrow" aria-hidden="true">↗</span></a>
        <a class="service-card" href="/services"><span class="service-number">03</span><span class="service-icon"><ServiceIcon type="support" /></span><h3>Ongoing help<br />&amp; guidance</h3><p>Get a thoughtful partner to troubleshoot, plan ahead, and keep moving forward.</p><span class="service-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div></section>
    <section class="cta-section wrap"><div class="cta-inner"><span class="cta-spark">↗</span><p class="eyebrow">Have a challenge to solve?</p><h2>Let's find a<br />better way <em>forward.</em></h2><a class="button button-light" href="/contact">Talk with our team <span aria-hidden="true">↗</span></a><span class="cta-ring ring-one"></span><span class="cta-ring ring-two"></span></div></section>
  </main>
  <Footer />
</BaseLayout>
