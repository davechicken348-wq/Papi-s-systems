---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';

const serviceCards = [
  { number: '01', type: 'systems', title: 'Web development', tone: 'plum', description: 'A clear, polished website built around your business and the people it serves.' },
  { number: '02', type: 'workflow', title: 'Mobile apps', tone: 'pink', description: 'Useful mobile experiences designed to make everyday tasks feel simpler.' },
  { number: '03', type: 'systems', title: 'Software solutions', tone: 'blue', description: 'Purpose-built software and integrations that fit the way your team works.' },
  { number: '04', type: 'workflow', title: 'UI/UX design', tone: 'mint', description: 'Thoughtful interfaces that make digital products easier to understand and use.' },
  { number: '05', type: 'systems', title: 'Cloud solutions', tone: 'orange', description: 'Cloud setup and guidance to help your people work securely from anywhere.' },
  { number: '06', type: 'workflow', title: 'Networking', tone: 'lavender', description: 'Dependable network planning, setup, and troubleshooting for your workplace.' },
  { number: '07', type: 'support', title: 'Cybersecurity', tone: 'yellow', description: 'Practical security measures to help protect your systems, accounts, and data.' },
  { number: '08', type: 'systems', title: 'Database management', tone: 'green', description: 'Organize, maintain, and make better use of the information your business relies on.' },
  { number: '09', type: 'support', title: 'IT support', tone: 'dark', description: 'Friendly hands-on help for technical issues, planning, and ongoing care.' },
];
---

<BaseLayout title="Services | Papi's Systems" description="Web development, software, cloud, cybersecurity, networking, and practical IT support for growing businesses.">
  <Header active="/services" />
  <main class="services-page">
    <section class="services-landing wrap">
      <div class="services-landing-top"><p class="eyebrow"><span class="eyebrow-dot"></span> OUR SERVICES / BUILT AROUND YOU</p><span>ABIDJAN · ONLINE</span></div>
      <div class="services-landing-copy">
        <h1>Technology for<br /><em>what's next.</em></h1>
        <div><p>From your first website to the systems behind your business, we make technology easier to choose, use, and grow with.</p><a class="button" href="/contact">Tell us what you need <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="services-showcase wrap" aria-label="Technology services in action">
      <article class="services-showcase-card showcase-code"><img src="https://images.unsplash.com/photo-1573166613605-3b4dfcbf1268?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="Black woman working at a laptop as a software professional" loading="lazy" /><div><span>DESIGN + DEVELOPMENT</span><strong>Digital experiences,<br />made for people.</strong></div></article>
      <article class="services-showcase-card showcase-lagos"><img src="https://images.unsplash.com/photo-1528901166007-3784c7dd3653?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="Developers collaborating on a project in Lagos" loading="lazy" /><div><span>SOFTWARE + SYSTEMS</span><strong>Tools that fit<br />your workflow.</strong></div></article>
      <article class="services-showcase-card showcase-support"><img src="https://images.unsplash.com/photo-1573166717911-d3625658b6f7?auto=format&amp;fit=crop&amp;w=1000&amp;q=85" alt="A Black woman technology professional working at a laptop" loading="lazy" /><div><span>SUPPORT + GUIDANCE</span><strong>Help when it<br />matters most.</strong></div></article>
    </section>

    <section class="services-principles wrap">
      <div class="services-principles-heading"><p class="eyebrow">THE WAY WE WORK</p><h2>Less tech stress.<br /><em>More room to grow.</em></h2><p>Every business has its own moving parts. We listen first, make a clear plan, then build and support the technology around your real needs.</p><a class="text-link" href="/about">Get to know us <span aria-hidden="true">→</span></a></div>
      <div class="services-principles-board">
        <article class="principle-card principle-build"><span>01 / BUILD</span><strong>Start with<br />your goals.</strong><i aria-hidden="true">↗</i></article>
        <article class="principle-card principle-connect"><span>02 / CONNECT</span><strong>Make your tools<br />work together.</strong><i aria-hidden="true">⌘</i></article>
        <article class="principle-card principle-protect"><span>03 / PROTECT</span><strong>Keep the important<br />things safer.</strong><i aria-hidden="true">✳</i></article>
        <article class="principle-card principle-support"><span>04 / SUPPORT</span><strong>Keep moving<br />with confidence.</strong><i aria-hidden="true">↗</i></article>
      </div>
    </section>

    <section class="services-catalog">
      <div class="wrap">
        <div class="services-catalog-heading"><div><p class="eyebrow"><span class="eyebrow-dot"></span> WHAT WE CAN DO</p><h2>Find the right<br /><em>kind of help.</em></h2></div><p>Choose one area or bring us the whole challenge. We'll help you figure out a useful next step.</p></div>
        <div class="services-catalog-grid">
          {serviceCards.map((service) => <a class={`services-catalog-card tone-${service.tone}`} href="/contact"><span class="services-card-top"><span>{service.number} / SERVICE</span><span class="services-card-icon"><ServiceIcon type={service.type} /></span></span><h3>{service.title}</h3><p>{service.description}</p><span class="services-card-arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </section>

    <section class="services-approach wrap">
      <div class="approach-copy"><p class="eyebrow">A GOOD PLACE TO BEGIN</p><h2>Not sure what<br />you need <em>yet?</em></h2><p>That's completely fine. Tell us what feels difficult or what you're hoping to improve. We'll talk it through with you and help make the options clear.</p><a class="button" href="/contact">Let's talk <span aria-hidden="true">↗</span></a></div>
      <div class="approach-panel"><span>YOUR FIRST CONVERSATION</span><ol><li><i>01</i><div><strong>Tell us what's going on</strong><p>Share the goals, questions, or everyday frustrations on your mind.</p></div></li><li><i>02</i><div><strong>Get a clear next step</strong><p>We'll discuss practical options in straightforward language.</p></div></li><li><i>03</i><div><strong>Move at your pace</strong><p>Decide what makes sense for your team and your business.</p></div></li></ol></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
