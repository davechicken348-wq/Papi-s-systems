---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const workProjects = [
  { number: '01', title: 'UnimartX Shop', type: 'Online shop', category: 'commerce', url: 'https://unimartxshop.vercel.app/', description: 'An online shopping experience, built for browsing and discovering products.' },
  { number: '02', title: 'Dabi Hostels', type: 'Hospitality website', category: 'hospitality', url: 'https://dabihostels.vercel.app/', description: 'A dedicated web presence for Dabi Hostels.' },
];
---

<BaseLayout title="Our Work | Papi's Systems" description="Explore live projects by Papi's Systems: UnimartX Shop and Dabi Hostels.">
  <Header active="/projects" />
  <main class="work-page">
    <section class="work-hero">
      <img class="work-hero-image" src="https://images.unsplash.com/photo-1617228679684-890412dc57a5?auto=format&amp;fit=crop&amp;w=2000&amp;q=80&amp;ixlib=rb-4.1.0&amp;ixid=NHwxMjA3fDA%3D" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="work-hero-tint" aria-hidden="true"></div>
      <div class="work-hero-panel">
        <div class="work-topline"><span>THE PAPI'S SYSTEMS APPROACH</span><span>ABIDJAN · ACCRA · ONLINE</span></div>
        <h1><span>WORK</span><i>THAT</i><span>WORKS</span></h1>
        <div class="work-hero-bottom"><span>Practical technology, made around real people.</span><a href="#work-areas">EXPLORE WHAT WE DO <b aria-hidden="true">↓</b></a></div>
      </div>
    </section>

    <section class="work-intro wrap">
      <div class="work-intro-label"><span class="eyebrow"><span class="eyebrow-dot"></span> OUR WORK / OUR APPROACH</span><span>01 — 02 / SELECTED PROJECTS</span></div>
      <div class="work-intro-content"><h2>Good work starts<br />with <em>good questions.</em></h2><div><p>Two live projects built for real needs: an online shop and a website for a hostel brand. Open each one to explore the work in action.</p><a class="text-link" href="/contact">Have a project in mind? <span aria-hidden="true">→</span></a></div></div>
      <div class="work-category-bar" aria-label="Filter projects">
        <button class="work-filter is-active" type="button" data-work-filter="all"><span>◆</span> Featured</button>
        <button class="work-filter" type="button" data-work-filter="commerce">E-commerce</button>
        <button class="work-filter" type="button" data-work-filter="hospitality">Hospitality</button>
        <span class="work-category-note">FEATURED / PROJECTS</span>
      </div>
    </section>

    <section class="work-areas wrap" id="work-areas" aria-label="Featured projects">
      {workProjects.map((project) => <article class="work-area-card work-project-card" data-work-category={project.category}>
        <div class={`work-project-preview preview-${project.category}`}>
          <div class="work-project-browser"><span class="browser-dots"><i></i><i></i><i></i></span><span class="browser-address">{project.url.replace('https://', '')}</span></div>
          <iframe src={project.url} title={`${project.title} live website preview`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <a class="work-project-preview-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} live website`}>OPEN LIVE SITE <span aria-hidden="true">↗</span></a>
        </div>
        <div class="work-area-meta"><span>{project.number} / {project.type}</span><span>LIVE WEBSITE</span></div>
        <h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.title} <span aria-hidden="true">↗</span></a></h3>
        <p class="work-project-description">{project.description}</p>
      </article>)}
    </section>

    <section class="work-method">
      <div class="wrap work-method-inner">
        <div><p class="eyebrow">A LITTLE MORE THAN THE DELIVERABLE</p><h2>Build it with care.<br /><em>Keep showing up.</em></h2></div>
        <p>Good technology takes more than a launch. It takes listening to the people who use it, making thoughtful choices, and staying close as the business changes.</p>
        <div class="work-method-steps"><span><b>01</b> LISTEN</span><span><b>02</b> MAKE A PLAN</span><span><b>03</b> BUILD + SUPPORT</span></div>
      </div>
    </section>

    <section class="work-cta wrap"><div class="work-cta-art" aria-hidden="true"><i></i><i></i><i></i></div><div><p class="eyebrow">HAVE SOMETHING IN MIND?</p><h2>Let's make your<br /><em>next step work.</em></h2><a class="button button-light" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a></div><span class="work-cta-stamp">PAPI'S<br />SYSTEMS<br />/ 2026</span></section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const filters = document.querySelectorAll('[data-work-filter]');
  const cards = document.querySelectorAll('[data-work-category]');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-work-filter');
      filters.forEach((button) => button.classList.toggle('is-active', button === filter));
      cards.forEach((card) => {
        const matches = category === 'all' || card.getAttribute('data-work-category') === category;
        card.toggleAttribute('hidden', !matches);
      });
    });
  });
</script>
